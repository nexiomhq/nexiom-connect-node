{
  "name": "@nexiom/connect",
  "version": "0.1.0",
  "description": "The official Nexiom Connect SDK for Node.js",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Nexiom Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexiomhq/nexiom-connect-node.git"
  },
  "homepage": "https://github.com/nexiomhq/nexiom-connect-node#readme",
  "bugs": {
    "url": "https://github.com/nexiomhq/nexiom-connect-node/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs && tsc -p tests/types/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
